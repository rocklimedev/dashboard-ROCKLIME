# Copy to backend/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=5050

# Front-end address: used in email links and CORS
APP_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# MySQL / MariaDB (main data)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cm_erp_local
DB_USER=cm_erp
DB_PASSWORD=

# Separate database for automated tests (never the live one)
TEST_DB_HOST=127.0.0.1
TEST_DB_NAME=cm_erp_test
TEST_DB_USER=cm_erp
TEST_DB_PASSWORD=

# MongoDB (carts, notifications) and Redis (background jobs)
MONGO_URI=mongodb://127.0.0.1:27017/cm_erp_local
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Login tokens. Use a long random value: openssl rand -hex 64
JWT_SECRET=
REFRESH_SECRET=
JWT_TOKEN_LIFE=12h

# Who receives "admin" notifications for orders and dispatches (a user ID)
ADMIN_USER_ID=

# Uploads: "local" saves to backend/uploads; otherwise FTP
UPLOAD_MODE=local
UPLOAD_DIR=
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
FTP_BASE_URL=
MEDIA_BASE_URL=

# Email (SMTP). With SMTP_DISABLED=true or no SMTP_PASS, emails are only logged.
SMTP_DISABLED=true
SMTP_HOST=sh200.bigrock.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@static.cmtradingco.com
SMTP_PASS=

# Request limits per IP (15-minute window) and per minute for busy routes
RATE_LIMIT_MAX=2000
RATE_LIMIT_BURST_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Database connection pool
DB_POOL_MAX=15

# Public addresses of the API (used in share links and emails)
BASE_API_URL=http://localhost:5050/api
PUBLIC_BACKEND_URL=http://localhost:5050
# Where operations files (stock counts, imports) are kept; empty = backend/storage
OPERATIONS_STORAGE_DIR=

# Email (Mailgun) and newsletter (Mailchimp); leave empty to switch off
MAILGUN_KEY=
MAILGUN_DOMAIN=
MAILGUN_EMAIL_SENDER=
MAILCHIMP_KEY=
MAILCHIMP_LIST_KEY=

# Zoho Bigin (CRM app). Create a "Server-based Application" client at
# https://api-console.zoho.in (or reuse the INOS client) and add the redirect URI
# below to it. An administrator then clicks "Connect Zoho Bigin" in CRM → Bigin connection.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:5050/api/crm/bigin/callback
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# Optional: a Self Client refresh token instead of the Connect button
ZOHO_BIGIN_REFRESH_TOKEN=
# CRM_AUTO_SYNC=0 turns off the 15-minute Bigin sync
