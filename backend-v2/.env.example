# App
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000
BASE_API_URL=http://localhost:4000

# MySQL (Sequelize) - either DATABASE_URL or the individual vars below
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erp_db
DB_USER=root
DB_PASSWORD=

# MongoDB (kept for logs / activity / permission cache, same role as legacy dbMongo.js)
MONGO_URI=mongodb://127.0.0.1:27017/erp_logs

# Redis (BullMQ queues, replaces lib/queue.js + workers/*)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT
JWT_SECRET=change_me
JWT_ACCESS_EXPIRES=7d
REFRESH_SECRET=change_me_too
JWT_REFRESH_EXPIRES=7d

# Mail (replaces middleware/sendMail.js)
RESEND_API_KEY=
MAIL_FROM=no-reply@example.com
